 "structures": [
  {
   "id": "not-just",
   "name": "\"No es solo X, es Y\" (It's not just X, it's Y)",
   "regex": "(?i)\\bno\\s+(?:es|son|fue)\\s+(?:s[oó]lo|solamente|simplemente|[uú]nicamente)\\s+[^.!?\\n]{2,60}[,.]\\s*(?:es|son|fue|sino)\\b|\\bno\\s+se\\s+trata\\s+(?:s[oó]lo\\s+|solamente\\s+|simplemente\\s+|[uú]nicamente\\s+)?de\\s+[^.!?\\n]{2,80}[,.]\\s*(?:sino|se\\s+trata)\\b",
   "fix": "Say the one thing you actually mean. Delete the setup half."
  },
  {
   "id": "not-only",
   "name": "\"No solo X, sino también Y\" (Not only X but also Y)",
   "regex": "(?i)\\bno\\s+s[oó]lo\\b[^.!?\\n]{2,80}\\bsino\\s+(?:tambi[eé]n|que)\\b",
   "fix": "Split into two sentences, or drop the weaker half."
  },
  {
   "id": "isnt-about",
   "name": "\"Esto no va de X. Va de Y.\" (It isn't about X. It's about Y.)",
   "regex": "(?i)\\bno\\s+(?:va|se\\s+trata)\\s+de\\s+[^.!?\\n]{2,60}[.!]\\s*(?:va|se\\s+trata|es)\\s+de\\b",
   "fix": "Lead with Y. The reversal is the tell."
  },
  {
   "id": "the-result",
   "name": "One-phrase rhetorical question line (¿El resultado?)",
   "regex": "(?im)^\\s*¿?(?:el\\s+resultado|la\\s+mejor\\s+parte|el\\s+truco|el\\s+problema|la\\s+clave|el\\s+secreto|lo\\s+mejor)\\?\\s*$",
   "fix": "Answer it inline instead of staging a reveal."
  },
  {
   "id": "heres-what",
   "name": "\"Esto es lo que aprendí\" (Here's what I learned)",
   "regex": "(?i)\\b(?:esto\\s+es|esto\\s+fue|aqu[ií]\\s+(?:est[aá]|va))\\s+lo\\s+que\\s+(?:aprend[ií]|aprendimos)\\b",
   "fix": "State the lesson. Skip the announcement."
  },
  {
   "id": "triad",
   "name": "Rule-of-three triad (X, Y y Z.)",
   "regex": "(?i)\\b\\w+, \\w+ y \\w+\\.",
   "fix": "Two items or four. Three is the model's default rhythm."
  },
  {
   "id": "rocket",
   "name": "Rocket / fire / bulb / sparkle / dart emoji",
   "regex": "[🚀🔥💡✨🎯]",
   "fix": "One emoji max, and not one of these five."
  },
  {
   "id": "hashtag-wall",
   "name": "Hashtag wall (5+)",
   "regex": "(?:#\\w+[ \\t]*){5,}",
   "fix": "Three hashtags. Instagram now caps a post at five and a wall reads as old."
  },
  {
   "id": "as-an-ai",
   "name": "Model self-reference (Como modelo de lenguaje)",
   "regex": "(?i)\\bcomo\\s+(?:un\\s+|una\\s+)?(?:ia\\b|modelo\\s+de\\s+lenguaje|inteligencia\\s+artificial|asistente\\s+de\\s+ia)",
   "fix": "Delete the sentence."
  },
  {
   "id": "in-summary",
   "name": "Essay-closer opener (En resumen / En conclusión)",
   "regex": "(?im)^\\s*(?:en\\s+resumen|en\\s+conclusi[oó]n|para\\s+resumir|en\\s+s[ií]ntesis|para\\s+concluir|en\\s+definitiva)\\b",
   "fix": "A post does not need a conclusion paragraph."
  },
  {
   "id": "engagement-bait",
   "name": "Reflex engagement bait (¿Qué opinas?)",
   "regex": "(?i)(?:\\bte\\s+parece\\?|\\bqu[eé]\\s+opinas\\?|\\bqu[eé]\\s+piensas\\?|\\best[aá]s\\s+de\\s+acuerdo\\?|\\bqui[eé]n\\s+m[aá]s\\b[^.!?\\n]{0,20}\\??|\\bme\\s+equivoco\\?)\\s*$",
   "fix": "Ask a question only you could ask, about the specific thing above it."
  },
  {
   "id": "stop-scroll",
   "name": "\"Deja de hacer scroll\" opener (Stop scrolling)",
   "regex": "(?im)^\\s*[¡]?\\s*(?:det[eé]n|para|deja)\\s+(?:de\\s+hacer\\s+|el\\s+)?scroll\\b|^\\s*[¡]?\\s*(?:espera|no\\s+te\\s+vayas|no\\s+sigas\\s+bajando)\\b",
   "fix": "The scroll-stop has to be the claim itself. Asking for attention is the tell that you have not earned it."
  },
  {
   "id": "in-this-video",
   "name": "Video preamble (\"en este video te voy a mostrar\")",
   "regex": "(?i)\\b(?:en\\s+(?:este|esta|el)\\s+(?:v[ií]deo|reel|post|publicaci[oó]n)|hoy\\s+(?:te\\s+voy\\s+a|voy\\s+a|vamos\\s+a)\\s+(?:ense[ñn]ar|mostrar|explicar|contar|ver)|te\\s+voy\\s+a\\s+(?:ense[ñn]ar|mostrar|explicar))\\b",
   "fix": "Delete it and start at the payoff. The first two seconds decide the whole reel."
  },
  {
   "id": "emoji-bullets",
   "name": "Emoji bullet list",
   "regex": "(?m)^\\s*[🌀-🫿✅➡⬅✔✨]\\s*\\S",
   "fix": "Use a hyphen or a line break. Emoji bullets are the single most template-looking thing in a caption."
  },
  {
   "id": "caps-shout",
   "name": "Three or more shouted words in a row",
   "regex": "\\b[A-ZÁÉÍÓÚÑ]{3,}\\b(?:\\s+\\b[A-ZÁÉÍÓÚÑ]{3,}\\b){2,}",
   "fix": "Caps are a volume knob, not a highlighter. One word, at most."
  },
  {
   "id": "follow-bait",
   "name": "Reflex follow or tag bait (síguenos para más)",
   "regex": "(?i)\\b(?:s[ií]gueme\\s+para\\s+m[aá]s|etiqueta\\s+a\\s+(?:alguien|un\\s+amigo|una\\s+amiga|esa\\s+persona)|doble\\s+tap\\s+si|dale\\s+(?:me\\s+gusta|like)\\s+si|comparte(?:lo)?\\s+si|comenta\\s+abajo\\s+si)\\b",
   "fix": "Ask for the one action this post actually earns. The generic ask trains the audience to ignore every ask."
  },
  {
   "id": "y-si-te-dijera",
   "name": "\"¿Y si te dijera que...?\" (What if I told you)",
   "regex": "(?i)¿\\s*y\\s+si\\s+te\\s+dijera\\s+que\\b",
   "fix": "Say the claim. The rhetorical wind-up is the tell."
  }
 ]
}
